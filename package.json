{
  "name": "online-meat-shop",
  "version": "0.1.0",
  "description": "Online store for a butcher shop: cut-to-order meat, weighed and billed on actual weight, home delivery only.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:runtime": "node scripts/scan-runtime.mjs",
    "test:db": "vitest run --config vitest.integration.config.ts",
    "db:test:up": "docker run -d --rm --name meatshop-testdb -e POSTGRES_PASSWORD=postgres -p 5433:5432 postgres:17",
    "db:test:down": "docker rm -f meatshop-testdb",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.6.1",
    "next": "^16.3.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
