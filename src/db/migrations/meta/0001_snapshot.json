      "checkConstraints": {
        "product_pricing_mode_xor": {
          "name": "product_pricing_mode_xor",
          "value": "(\n        \"product\".\"pricing_mode\" = 'pack'\n        AND \"product\".\"pack_price_cents\" IS NOT NULL AND \"product\".\"w_min_g\" IS NOT NULL AND \"product\".\"w_max_g\" IS NOT NULL\n        AND \"product\".\"rate_per_kg_cents\" IS NULL AND \"product\".\"min_order_g\" IS NULL AND \"product\".\"step_g\" IS NULL\n      ) OR (\n        \"product\".\"pricing_mode\" = 'perKg'\n        AND \"product\".\"rate_per_kg_cents\" IS NOT NULL AND \"product\".\"min_order_g\" IS NOT NULL AND \"product\".\"step_g\" IS NOT NULL\n        AND \"product\".\"pack_price_cents\" IS NULL AND \"product\".\"w_min_g\" IS NULL AND \"product\".\"w_max_g\" IS NULL\n      )"
        },
        "product_pack_range_valid": {
          "name": "product_pack_range_valid",
          "value": "\"product\".\"pricing_mode\" <> 'pack' OR (\n        \"product\".\"pack_price_cents\" > 0 AND \"product\".\"w_min_g\" > 0 AND \"product\".\"w_min_g\" <= \"product\".\"w_max_g\"\n      )"
        },
        "product_perkg_valid": {
          "name": "product_perkg_valid",
          "value": "\"product\".\"pricing_mode\" <> 'perKg' OR (\n        \"product\".\"rate_per_kg_cents\" > 0 AND \"product\".\"step_g\" > 0 AND \"product\".\"min_order_g\" >= \"product\".\"step_g\"\n      )"
        }
      },
