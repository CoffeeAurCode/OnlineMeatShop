# Copy to .env.local and fill in. NEVER commit the filled-in version.
# This repository is public — see .gitignore and CLAUDE.md.

# ── Database (Supabase, ca-central-1) ────────────────────────────────
# TRANSACTION pooler, port 6543. Used by the application.
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Server-side prepared statements must stay off on this endpoint — see
# src/db/client.ts.
DATABASE_URL=

# SESSION pooler, port 5432. Used by migrations and pg_dump ONLY, and never
# present in the web service's environment.
#   postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# NOT db.<ref>.supabase.co:5432, which is what the Supabase dashboard calls the
# "direct connection". That hostname publishes an AAAA record and no A record.
# GitHub Actions runners have no IPv6, so migrations and backups fail there with
# ENOTFOUND — an error that reads like a typo and is not one.
DIRECT_DATABASE_URL=

# ── Supabase ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit.
# A leaked service-role key in a public repo is scraped within minutes.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Backups ──────────────────────────────────────────────────────────
# There are no backup variables any more, and that is the point.
#
# The scheduled dump workflow and its six BACKUP_* secrets — object storage,
# an encryption passphrase, a dead-man's-switch URL — were deleted rather than
# repaired. They were the project's only HIGH defect, and a paid database tier
# does the same job without three extra accounts to keep alive. Until that tier
# is active the cover is a MANUAL dump before every migration and once a week:
# docs/restore-procedure.md.
#
# ── Keep-alive (GitHub Actions secrets, not application runtime) ──────
# The free database tier PAUSES a project after 7 days idle, and a paused
# database is a down website. .github/workflows/keepalive.yml pings it every
# two days. Repository secrets, never read by the application:
#
# KEEPALIVE_APP_URL            https://<host>/healthz
# NEXT_PUBLIC_SUPABASE_URL     (same value as below)
# SUPABASE_ANON_KEY            (same value as below; public by design)
#
# Delete the workflow and these three once the project is on the paid tier.

# ── Notifications ────────────────────────────────────────────────────
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Shop configuration ───────────────────────────────────────────────
# Real values live in the deployment environment, NOT in this repository.
# The shop's name, address, licence number and delivery area are client
# data and must never be committed here.
SHOP_TIMEZONE=America/Toronto
SHOP_CURRENCY=CAD
WEIGHT_TOLERANCE=0.10

# ── Staff sign-in (the console's only door) ─────────────────────────────────
#
# ⚠ WITH NO SECRET THE CONSOLE FAILS CLOSED. No session can be signed, so
# nobody can sign in, including you. That is deliberate: an unauthenticated
# console that edits stock and money is worse than an unavailable one.
#
# At least 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Rotating it signs everyone out immediately, which is the intended way to
# revoke every session at once.
STAFF_SESSION_SECRET=

# There is deliberately NO sign-up route. Create the account from a shell that
# already has the database URL:
#   printf 'the-password' | node scripts/create-staff.mjs owner

# ── Payments ────────────────────────────────────────────────────────────────
#
# ⚠ Set this ONLY for a deliberate no-money demo deployment. The stub adapter
# places real orders, reserves real stock and takes no payment; reaching
# production with it is the most expensive failure this shop can have, so the
# app refuses to start in production without this flag.
#
# Orders it creates are `pay_mode = PREPAID` on purpose, so NOTHING in the data
# distinguishes them from real prepaid orders except `payment.provider = 'stub'`.
# Anything that reads takings must filter on that.
ALLOW_STUB_PAYMENTS=

# ── Order history (the stub phone verifier) ─────────────────────────────────
#
# ⚠ NOTHING IS VERIFIED. The stub accepts this one fixed code for every number,
# which is why "my orders" is the ONLY thing behind it: order tracking is gated
# on the order's own unguessable token, never on a phone number.
#
# There is deliberately no ALLOW_STUB_VERIFIER escape hatch. The app REFUSES to
# construct a stub verifier in production at all. A no-money demo deployment is
# a coherent thing to want; a deployment that hands out other people's order
# history to anyone who knows the dev code is not.
#
# Leave BLANK and order history is simply unavailable, which is the safe state.
DEV_VERIFICATION_CODE=
